# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=                      # postgresql://user:pass@host/db?sslmode=require
NODE_ENV=development
PORT=5000

# ── Optional ───────────────────────────────────────────────────────────────
USER_STATS_REPORT_EMAIL=           # fallback recipient for the daily lock-usage report when the per-tenant setting is empty; unset = report skipped

# ── Vendor admin (cross-tenant admin login) ────────────────────────────────
VENDOR_ADMIN_USERNAME=
VENDOR_ADMIN_PASSWORD=

# ── Integration seeds ──────────────────────────────────────────────────────
# Only used to seed EMPTY per-tenant settings on first start. Once a value
# exists in the settings table it is managed in the Settings UI and these are
# ignored. Leave blank and configure in the UI if you prefer.

# TTLock open platform app + the account that owns the locks
TTLOCK_CLIENT_ID=
TTLOCK_API_KEY=                    # client secret
TTLOCK_OWNER_USERNAME=
TTLOCK_OWNER_PASSWORD=

# MEWS Connector API
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_PLATFORM_URL=https://api.mews.com

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
